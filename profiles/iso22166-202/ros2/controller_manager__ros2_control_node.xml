    <ros:Variable direction="output" transport="ROS 2 topic" name="~/activity" dataType="controller_manager_msgs/msg/ControllerManagerActivity" />
    <ros:Variable direction="input" transport="ROS 2 topic" name="robot_description" dataType="std_msgs/msg/String" />
  </ros:IOVariables>
