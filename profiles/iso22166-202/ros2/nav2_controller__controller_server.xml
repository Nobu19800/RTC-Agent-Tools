    <ros:Parameter name="costmap_update_timeout" dataType="double">
      <ros:Default>0.3</ros:Default>
    </ros:Parameter>
    <ros:Parameter name="enable_stamped_cmd_vel" dataType="bool">
      <ros:Default>false</ros:Default>
    </ros:Parameter>
  </ros:Parameters>
