  <ros:IOVariables>
    <ros:Description>Serves follow_path and publishes velocity commands. Twist versus TwistStamped depends on the selected version and configuration.</ros:Description>
    <ros:Variable direction="output" transport="ROS 2 topic" name="cmd_vel" dataType="geometry_msgs/msg/Twist" />
