  </ros:IOVariables>
  <ros:Services>
    <ros:Service kind="action" name="follow_path" dataType="nav2_msgs/action/FollowPath" />
  </ros:Services>
  <ros:Parameters>
    <ros:Parameter name="controller_frequency" dataType="double">
      <ros:Default>20.0</ros:Default>
    </ros:Parameter>
    <ros:Parameter name="action_server_result_timeout" dataType="double">
      <ros:Default>10.0</ros:Default>
    </ros:Parameter>
    <ros:Parameter name="min_x_velocity_threshold" dataType="double">
      <ros:Default>0.0001</ros:Default>
    </ros:Parameter>
    <ros:Parameter name="min_y_velocity_threshold" dataType="double">
      <ros:Default>0.0001</ros:Default>
    </ros:Parameter>
    <ros:Parameter name="min_theta_velocity_threshold" dataType="double">
      <ros:Default>0.0001</ros:Default>
    </ros:Parameter>
    <ros:Parameter name="speed_limit_topic" dataType="string">
      <ros:Default>"speed_limit"</ros:Default>
    </ros:Parameter>
    <ros:Parameter name="failure_tolerance" dataType="double">
      <ros:Default>0.0</ros:Default>
    </ros:Parameter>
    <ros:Parameter name="use_realtime_priority" dataType="bool">
