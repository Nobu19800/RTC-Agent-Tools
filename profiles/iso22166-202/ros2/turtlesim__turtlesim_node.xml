<?xml version='1.0' encoding='utf-8'?>
<ros:Module xmlns:ros="urn:rtc-agent-tools:iso22166-202:ros2-mapping:0.1" targetStandard="ISO 22166-202:2025" profileVersion="0.1" conformanceStatus="not-assessed">
  <ros:GenInfo>
    <ros:ModuleName>turtlesim_node</ros:ModuleName>
    <ros:Description>Runs the Qt turtle simulator.</ros:Description>
  </ros:GenInfo>
  <ros:IDnType>
    <ros:ID>urn:uuid:4262e74d-d130-5ade-ae33-fbd89bbacb47</ros:ID>
    <ros:InformationModelVersion>local-mapping-0.1</ros:InformationModelVersion>
  </ros:IDnType>
  <ros:ModuleProp>
    <ros:Property name="rosPackage">turtlesim</ros:Property>
    <ros:Property name="category">Simulation</ros:Property>
  </ros:ModuleProp>
  <ros:IOVariables>
    <ros:Description>Controls the default turtle and exposes its pose, color sensor, and lifecycle controls.</ros:Description>
    <ros:Variable direction="input" transport="ROS 2 topic" name="turtle1/cmd_vel" dataType="geometry_msgs/msg/Twist" />
    <ros:Variable direction="output" transport="ROS 2 topic" name="turtle1/pose" dataType="turtlesim/msg/Pose" />
    <ros:Variable direction="output" transport="ROS 2 topic" name="turtle1/color_sensor" dataType="turtlesim/msg/Color" />
    <ros:Variable direction="input" transport="ROS 2 topic" name="/parameter_events" dataType="rcl_interfaces/msg/ParameterEvent" />
  </ros:IOVariables>
  <ros:Services>
    <ros:Service kind="service" role="server" name="clear" dataType="std_srvs/srv/Empty" />
    <ros:Service kind="service" role="server" name="reset" dataType="std_srvs/srv/Empty" />
    <ros:Service kind="service" role="server" name="spawn" dataType="turtlesim/srv/Spawn" />
    <ros:Service kind="service" role="server" name="kill" dataType="turtlesim/srv/Kill" />
    <ros:Service kind="service" role="server" name="turtle1/set_pen" dataType="turtlesim/srv/SetPen" />
    <ros:Service kind="service" role="server" name="turtle1/teleport_absolute" dataType="turtlesim/srv/TeleportAbsolute" />
    <ros:Service kind="service" role="server" name="turtle1/teleport_relative" dataType="turtlesim/srv/TeleportRelative" />
    <ros:Service kind="action" role="server" name="turtle1/rotate_absolute" dataType="turtlesim/action/RotateAbsolute" />
  </ros:Services>
  <ros:Parameters>
    <ros:Parameter name="background_r" dataType="int">
      <ros:Default>69</ros:Default>
    </ros:Parameter>
    <ros:Parameter name="background_g" dataType="int">
      <ros:Default>86</ros:Default>
    </ros:Parameter>
    <ros:Parameter name="background_b" dataType="int">
      <ros:Default>255</ros:Default>
    </ros:Parameter>
    <ros:Parameter name="holonomic" dataType="bool">
      <ros:Default>false</ros:Default>
    </ros:Parameter>
  </ros:Parameters>
  <ros:Infra>
    <ros:Requirement>ROS 2 Jazzy package ros-jazzy-turtlesim. Requires a Qt display. Names under turtle1 also exist for each additional spawned turtle.</ros:Requirement>
  </ros:Infra>
  <ros:ExecutableForm>
    <ros:Command>ros2</ros:Command>
    <ros:Argument>run</ros:Argument>
    <ros:Argument>turtlesim</ros:Argument>
    <ros:Argument>turtlesim_node</ros:Argument>
  </ros:ExecutableForm>
  <ros:Evidence>
    <ros:Source>https://github.com/ros/ros_tutorials/tree/c83136eb8d0d3ed52eb0906183dd86ca309a4ed2/turtlesim</ros:Source>
    <ros:UpstreamSource status="verified">https://github.com/ros/ros_tutorials/blob/c83136eb8d0d3ed52eb0906183dd86ca309a4ed2/turtlesim/CMakeLists.txt</ros:UpstreamSource>
    <ros:ImplementationSource>https://github.com/ros/ros_tutorials/blob/c83136eb8d0d3ed52eb0906183dd86ca309a4ed2/turtlesim/src/turtlesim.cpp</ros:ImplementationSource>
    <ros:AdditionalImplementationSource>https://github.com/ros/ros_tutorials/blob/c83136eb8d0d3ed52eb0906183dd86ca309a4ed2/turtlesim/src/turtle_frame.cpp</ros:AdditionalImplementationSource>
    <ros:AdditionalImplementationSource>https://github.com/ros/ros_tutorials/blob/c83136eb8d0d3ed52eb0906183dd86ca309a4ed2/turtlesim/src/turtle.cpp</ros:AdditionalImplementationSource>
    <ros:Verification>Interfaces were reviewed against the ROS 2 Jazzy source. Runtime behavior and Annex B conformance have not been verified.</ros:Verification>
  </ros:Evidence>
</ros:Module>
