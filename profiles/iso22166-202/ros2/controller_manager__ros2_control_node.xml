    <ros:Service kind="service" name="~/list_controllers" dataType="controller_manager_msgs/srv/ListControllers" />
    <ros:Service kind="service" name="~/list_controller_types" dataType="controller_manager_msgs/srv/ListControllerTypes" />
    <ros:Service kind="service" name="~/load_controller" dataType="controller_manager_msgs/srv/LoadController" />
    <ros:Service kind="service" name="~/configure_controller" dataType="controller_manager_msgs/srv/ConfigureController" />
    <ros:Service kind="service" name="~/reload_controller_libraries" dataType="controller_manager_msgs/srv/ReloadControllerLibraries" />
    <ros:Service kind="service" name="~/switch_controller" dataType="controller_manager_msgs/srv/SwitchController" />
    <ros:Service kind="service" name="~/unload_controller" dataType="controller_manager_msgs/srv/UnloadController" />
    <ros:Service kind="service" name="~/cleanup_controller" dataType="controller_manager_msgs/srv/CleanupController" />
    <ros:Service kind="service" name="~/list_hardware_components" dataType="controller_manager_msgs/srv/ListHardwareComponents" />
